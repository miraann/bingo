# Copy this file to .env.local for local development, and add the same two
# keys under Vercel → Project Settings → Environment Variables for production.
#
# Get these from your Supabase project: Settings → API.
# No database tables are required — this app only uses Realtime
# Broadcast/Presence channels, not Postgres.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
